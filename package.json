    "worldtest": "node tools/worldtest.mjs",
    "combattest": "node tools/combattest.mjs",
    "skilltest": "node tools/skilltest.mjs",
    "contenttest": "node tools/contenttest.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
